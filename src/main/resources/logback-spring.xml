<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!-- Filter to prevent internal spring/hibernate logs from messing up the console in interactive mode -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- Admin Actions File Appender -->
    <appender name="ADMIN_ACTIONS_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/admin-actions.log</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Async Appender for Admin Actions -->
    <appender name="ASYNC_ADMIN_ACTIONS" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ADMIN_ACTIONS_FILE" />
    </appender>

    <!-- Application Root Logger -->
    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Dedicated Logger for Admin Actions -->
    <logger name="AdminActionLogger" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_ADMIN_ACTIONS" />
    </logger>
</configuration>
